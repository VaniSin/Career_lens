# ==============================================================================
# Career Lens Environment Configuration
# ==============================================================================

# Groq API Key (starts with gsk_...)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Option 1: OpenAI ChatGPT API Key (starts with sk-...)
OPENAI_API_KEY=

# Option 2: Google Gemini API Key (starts with AIza...)
GEMINI_API_KEY=

# Model settings (optional, defaults to gpt-4o-mini / gemini-1.5-flash)
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# Flask settings
FLASK_SECRET_KEY=career-lens-secure-key-2026
PORT=5001
